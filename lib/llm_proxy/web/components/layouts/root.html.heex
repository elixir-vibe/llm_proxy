<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <title>LLM Proxy Admin</title>
    <link
      phx-track-static
      rel="stylesheet"
      href={Volt.static_path(LLMProxy.Web.Endpoint, "/assets/css/app.css")}
    />
    <script
      defer
      phx-track-static
      type="module"
      src={Volt.static_path(LLMProxy.Web.Endpoint, "/assets/js/app.js")}
    >
    </script>
  </head>
  <body class="bg-gray-50 antialiased">
    {@inner_content}
  </body>
</html>
